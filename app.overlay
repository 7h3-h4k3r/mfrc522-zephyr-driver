



&pinctrl{
	spirfid_default: spirfid_default {
		group1 {
			pinmux =  <SPI0_SCK_P18>, <SPI0_TX_P19>;
		};

		group2 {
			pinmux = <SPI0_RX_P16>;
			input-enable;
		};
	};
};


&spi0 {
	status = "okay";
	cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spirfid_default>;
	pinctrl-names = "default";
	
	rfid001:rfid@0{
		compatible = "nxp,mfrc522";
		reg = <0>;
		spi-max-frequency = <1000000>;
		reset-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
	};
};
